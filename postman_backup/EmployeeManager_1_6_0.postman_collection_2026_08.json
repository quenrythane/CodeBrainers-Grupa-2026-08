            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nvar response_data = pm.response.json();\r\n\r\npm.test(\"response data contains correct information\", function () {\r\n    pm.expect(response_data.name).to.eql(\"Adam\");\r\n    pm.expect(response_data.salary).to.eql(10000);\r\n    pm.expect(response_data.age).to.eql(31);\r\n    pm.expect(response_data.position).to.eql(\"Junior QA\");\r\n    pm.expect(response_data.on_leave).to.eql(false);\r\n});\r\n\r\npm.test(\"przydzielono id do nowegu usera\", function () {\r\n    pm.expect(response_data.id).to.be.a(\"number\");\r\n});\r\n\r\n\r\n"
            ]
