    {
      "name": "login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// pamietaj synchronicznie vs asynchronicze\r",
              "\r",
              "// zmienna = \"wartość\"\r",
              "// = z obiektu pm (Postman) pobierz odpowiedź (response), przefarmatuj go jako json (.json()) i z tego jsona weż wartość która kryje się pod kluczem access_token\r",
              "var returned_token = pm.response.json().access_token\r",
              "\r",
              "// pm.collectionVariables.set - ustawia zmieną\r",
              "// pierwsza pozycja z nawiasu to jak zmienna ma się nazywać\r",
              "// druga pozycja z nawiasu to jaką wartość ma mieć ta zmienna\r",
              "pm.collectionVariables.set(\"bearer_token\", returned_token);\r",
              "// pm.enviroment.set(\"bearer_token\", returned_token);\r",
              "\r",
              "// pm.collectionVariables.get - pobiera wartość zmiennej\r",
              "\r",
              "var employee_name = pm.collectionVariables.get(\"employee_name\")\r",
              "\r",
              "// print() console.log()\r",
              "console.log(employee_name)\r",
              "\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disabledSystemHeaders": {}
