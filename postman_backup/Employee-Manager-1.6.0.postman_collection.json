    {
      "name": "create_employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const expected = {",
              "  name: \"Cezary\",",
              "  salary: 4000,",
              "  age: 30,",
              "  position: \"Junior QA\",",
              "  on_leave: true,",
              "};",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "let jsonData;",
              "pm.test(\"Response is valid JSON\", function () {",
              "  jsonData = pm.response.json();",
              "  pm.expect(jsonData).to.be.an(\"object\");",
              "});",
              "",
              "pm.test(\"Response fields match expected values\", function () {",
              "  if (!jsonData) {",
              "    jsonData = pm.response.json();",
              "  }",
              "",
              "  pm.expect(jsonData.name).to.eql(expected.name);",
              "  pm.expect(jsonData.salary).to.eql(expected.salary);",
              "  pm.expect(jsonData.age).to.eql(expected.age);",
              "  pm.expect(jsonData.position).to.eql(expected.position);",
              "  pm.expect(jsonData.on_leave).to.eql(expected.on_leave);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
